-- allium: 3
-- mulog-aws-cloudwatch-emf-publisher.allium
--
-- Normative behaviour for publishing bounded, validated metric measurements
-- from Grain's telemetry stream. The publisher owns classification, validation,
-- buffering, aggregation, delivery accounting and shutdown drain.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity TelemetryEvent {
    metric_name: String?
    metric_value: Decimal?
    duration: Duration?
    metric_type: MetricType?
    unit: MetricUnit?
    resolution: ResolutionRequest?
    timestamp: Timestamp?
    dimensions: List<MetricDimension>
}

-- A name has one stable semantic definition for its lifetime.
external entity MetricDefinition {
    name: String
    metric_type: MetricType
    unit: MetricUnit
    default_resolution: StorageResolution
    allowed_dimension_names: Set<String>
    allowed_dimension_values: Set<String>
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value MetricDimension {
    name: String
    value: String
}

value PublicationResult {
    published_count: Integer
    invalid_count: Integer
    failed_count: Integer
    retained_count: Integer
}

value PublisherHealth {
    buffered: Integer
    published: Integer
    dropped: Integer
    invalid: Integer
    flush_failed: Integer
    buffer_utilization: Decimal
    last_successful_flush_at: Timestamp?
}

-- One valid JSON log event submitted to the configured output sink. Its single
-- timestamp and root target members apply to every metric it contains.
value EmfDocument {
    timestamp: Timestamp
    namespace: String
    dimensions: List<MetricDimension>
    measurements: List<Measurement>
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract MetricPublication {
    measure: (event: TelemetryEvent) -> Measurement?
    publish_batch: (events: List<TelemetryEvent>) -> PublicationResult
    encode: (measurements: List<Measurement>) -> List<EmfDocument>
    final_drain: () -> PublicationResult
    health: () -> PublisherHealth

    @invariant MetricRegistryIsAuthoritative
        -- A metric is publishable only when its name resolves to exactly one
        -- definition. The definition supplies its type, unit, default resolution
        -- and dimension vocabulary. Conflicting event metadata is invalid.

    @invariant ConsumerRegistryExtension
        -- A consumer may add application-owned metric definitions using the
        -- same type, unit, resolution and bounded-dimension schema as Grain.
        -- Consumer names must be disjoint from Grain's reserved metric names;
        -- attempting to replace a Grain definition is rejected rather than
        -- silently changing its lifetime semantics.

    @invariant LegacyClassification
        -- During migration, an unregistered named metric_value is a Count
        -- counter, while an unregistered named duration with no metric_value is
        -- a Milliseconds timer. Legacy low resolution maps to standard storage;
        -- every other legacy request maps to high storage.

    @invariant Validation
        -- Names, values, timestamps, units, resolutions and dimensions meet both
        -- EMF and MetricDatum constraints. Namespace and metric names contain 1
        -- through 255 permitted characters. Numeric values are finite and within
        -- CloudWatch's inclusive range from -2^360 through 2^360. Timers and
        -- counter increments are non-negative; gauges may be negative. Zero is
        -- valid for every metric type. Timestamps are no more than two weeks old
        -- and no more than two hours in the future.

    @invariant SafeDimensions
        -- Every dimension is explicitly permitted for that metric and has an
        -- allowed bounded value. Unknown dimensions and values are rejected.
        -- Entity, tenant, request and event identifiers; raw URLs; messages;
        -- payload values; credentials; tokens and personal data are forbidden.
        -- No metric has more than 30 dimensions. Dimension names contain 1
        -- through 255 permitted ASCII characters, cannot begin with a colon and
        -- contain no control characters. Values contain 1 through 1024 permitted
        -- ASCII characters, include a non-whitespace character and contain no
        -- control characters.

    @invariant DurationNormalization
        -- Durations are converted once into the definition's unit. A duration
        -- is never published as Count or as an implicit nanosecond value.

    @invariant StandardResolutionDefault
        -- Registered counters and gauges default to standard resolution. High
        -- resolution is used only when the metric definition permits it.

    @invariant Aggregation
        -- Measurements aggregate only when name, complete dimension set, unit
        -- and resolution match. Counters sum; gauges publish the last valid
        -- value in source order; timer samples retain their individual values.
        -- The aggregate uses the latest source timestamp represented by it.

    @invariant EmfDocumentShape
        -- Each sink record is exactly one valid JSON object with no surrounding
        -- text. It contains _aws.Timestamp as epoch milliseconds and one or more
        -- CloudWatchMetrics directives. Every directive contains Namespace,
        -- Dimensions and Metrics. Referenced metric and dimension targets are
        -- non-nested members of the root object. Metric targets are numbers or
        -- arrays of no more than 100 numbers; dimension targets are strings.

    @invariant EmfDocumentBounds
        -- No EMF log event exceeds AWS's 1 MB log-event limit. No directive
        -- contains more than 100 metric definitions, no numeric target array
        -- contains more than 100
        -- values and no dimension set contains more than 30 keys. A batch is
        -- split into additional documents before any bound would be exceeded.

    @invariant EmfTimestampScope
        -- One _aws.Timestamp applies to every measurement extracted from an EMF
        -- document. Measurements with different aggregate timestamps are emitted
        -- in different documents; per-metric timestamps are never implied.

    @invariant PerEventFailureIsolation
        -- Invalid input or failure to construct one measurement does not prevent
        -- other events in the flush from being considered. Every invalid event
        -- increments invalid accounting exactly once.

    @invariant DeliveryAccounting
        -- Measurements accepted by the configured output sink are removed and
        -- counted as published. This means accepted by stdout or another local
        -- sink, not extracted by CloudWatch. Output failure increments flush-
        -- failure accounting and retains only measurements not known to be
        -- accepted. Ambiguous failure can cause re-delivery.

    @invariant CloudWatchDeliverySemantics
        -- After a valid EMF log reaches CloudWatch Logs, AWS extraction provides
        -- at-least-once delivery and may create duplicate metric values. The
        -- publisher neither promises exactly-once extraction nor treats local
        -- sink acceptance as CloudWatch acknowledgement.

    @invariant RetryBound
        -- An unacknowledged measurement is retried no more than the configured
        -- attempt limit. Exhausted measurements are removed and counted dropped.

    @invariant Overflow
        -- Capacity is bounded. Under default drop-newest, an event arriving at
        -- capacity is not buffered and increments dropped exactly once. Any
        -- configured displacement also increments dropped exactly once.

    @invariant BoundedShutdown
        -- Shutdown stops accepting events and drains until empty or its deadline.
        -- Events remaining at the deadline are counted dropped, and shutdown
        -- never waits beyond the configured deadline for publication.

    @invariant IndependentHealth
        -- Publisher health remains observable while the output sink is failing
        -- and does not depend upon successful publication through that sink.
        -- Deployment monitoring also observes AWS/Logs EMFParsingErrors and
        -- EMFValidationErrors because local success cannot prove extraction.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum MetricType { counter | timer | gauge }
enum MetricUnit { count | milliseconds | seconds | bytes | percent | none }
enum StorageResolution { high | standard }
enum ResolutionRequest { high | standard | low }
enum OverflowPolicy { drop_newest | drop_oldest }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Measurement {
    source: TelemetryEvent
    definition: MetricDefinition?
    name: String
    value: Decimal
    metric_type: MetricType
    unit: MetricUnit
    storage_resolution: StorageResolution
    dimensions: List<MetricDimension>
    timestamp: Timestamp
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    namespace: String = "ObneyAI/InfoSystem"
    buffer_capacity: Integer = 10_000
    flush_interval: Duration = 0.2.seconds
    overflow_policy: OverflowPolicy = drop_newest
    max_delivery_attempts: Integer = 3
    final_drain_timeout: Duration = 5.seconds
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ObserveValidMetric {
    when: event: TelemetryEvent.created
    requires: valid_metric_event(event)
    ensures:
        Measurement.created(
            source: event,
            definition: metric_definition(event),
            name: normalized_metric_name(event),
            value: normalized_metric_value(event),
            metric_type: normalized_metric_type(event),
            unit: normalized_metric_unit(event),
            storage_resolution: normalized_resolution(event),
            dimensions: validated_dimensions(event),
            timestamp: normalized_timestamp(event)
        )

    @guidance
        -- Normalization is deterministic and performs no output delivery.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant MeasurementsHaveStableDefinitions {
    for measurement in Measurements:
        measurement.definition != null implies
            measurement.name = measurement.definition.name
            and measurement.metric_type = measurement.definition.metric_type
            and measurement.unit = measurement.definition.unit
}

invariant MeasurementValuesFollowType {
    for measurement in Measurements:
        measurement.metric_type = gauge or measurement.value >= 0
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface MetricPublishing {
    context event: TelemetryEvent

    exposes:
        event.metric_name
        event.metric_value
        event.duration
        event.metric_type
        event.unit
        event.resolution
        event.timestamp
        event.dimensions

    contracts:
        fulfils MetricPublication

    @guarantee BoundedSafePublication
        -- Only validated, bounded measurements are published; every accepted or
        -- discarded metric is accounted for; final drain is deadline-bounded.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred specification "The Grain metric registry defines every metric's stable type, unit, resolution, dimensions, bounded vocabularies and emission point."

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "What acceptance boundary can each supported output sink provide for distinguishing accepted writes from ambiguous local failures? CloudWatch extraction is explicitly outside this boundary."
open question "Should drop-oldest remain supported, or should drop-newest be the sole overflow policy?"
